    "#3 with paraters and retun\n",
    "## persons monthly salary from annum salary\n",
    "\n",
    "def msal(annumsalary):\n",
    "    msal=annumsalary/12\n",
    "    return msal\n",
    "\n",
    "R1=msal(60000)\n",
    "print(R1)\n",
    "R2=msal(120000)\n",
    "print(R2)\n",
